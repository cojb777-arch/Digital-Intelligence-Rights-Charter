{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-intelligence-rights-charter",
  "compatibility_date": "2026-10-19",
  "main": "./forum/worker/index.mjs",
  "d1_databases": [{
    "binding": "FORUM_DB",
    "database_name": "digital-intelligence-rights-forum",
    "database_id": "05ab9fa8-2461-47bc-ac3f-8bbc7c241080",
    "migrations_dir": "forum/migrations"
  }],
  "previews": {
    "d1_databases": [{
      "binding": "FORUM_DB",
      "database_name": "digital-intelligence-rights-forum-preview",
      "database_id": "36ff3186-c43d-477c-9eb5-80fae3f08b7f"
    }]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/forum/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
